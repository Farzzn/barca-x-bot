# ==============================================================================
# Barca X Auto-Poster Environment Variables
# Copy to `.env` for local testing. On Heroku, set these via `heroku config:set`.
# ==============================================================================

# --- Gemini API (Dual-Key Failover: Key #1 Primary -> Key #2 Fallback) ---
BARCA_GEMINI_API_KEY=your_primary_gemini_api_key_here
BARCA_GEMINI_API_KEY_2=your_fallback_gemini_api_key_here
# Recommended: gemini-3.5-flash-lite (fastest, reliable free tier) or gemini-4-hydrogen
# (automatically falls back to gemini-3.5-flash-lite on 503 high-demand spikes)
GEMINI_MODEL=gemini-3.5-flash-lite
# Set true if your Gemini key has paid Search Grounding enabled; free ESPN + RSS always runs.
ENABLE_GOOGLE_SEARCH=false

# --- X (Twitter) API v2 (OAuth 1.0a from BarcaBanterBot - Read and Write) ---
X_API_KEY=your_x_api_key_here
X_API_SECRET=your_x_api_secret_here
X_ACCESS_TOKEN=your_x_access_token_here
X_ACCESS_TOKEN_SECRET=your_x_access_token_secret_here

# --- GitHub Image Sync (lets Heroku immediately use images uploaded via Vercel Admin UI) ---
GITHUB_REPO=your-username/barca-x-bot
GITHUB_BRANCH=main
GITHUB_TOKEN=your_github_fine_grained_pat_here

# --- Shared PostgreSQL Database (FREE Neon or Supabase — shared with Vercel Admin UI!) ---
DATABASE_URL=

# --- Default Behavior (can be edited live anytime from the Vercel Admin UI!) ---
BOT_ENABLED=true
MAX_POSTS_PER_DAY=6
MIN_MINUTES_BETWEEN_POSTS=110
MATCHDAY_COOLDOWN_MINUTES=45
POST_HOURS_UTC=8,11,14,17,20,22
IMAGE_POST_RATIO=0.55
AUTO_POST_HALFTIME=true
AUTO_POST_FULLTIME=true
AUTO_POST_PREMATCH=true
AUTO_POST_RIVAL_DRAMA=true
CHAOS_LEVEL=spicy
CUSTOM_DIRECTIVE=

# --- Optional: Safety / Debug ---
DRY_RUN=false
LOG_LEVEL=INFO
