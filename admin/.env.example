# ==============================================================================
# Barca X Admin Dashboard (Next.js on Vercel)
# Copy to `admin/.env.local` for local dev. Set these in Vercel Project Settings.
# ==============================================================================

# --- Admin Login Password (REQUIRED on Vercel!) ---
ADMIN_PASSWORD=change_me_to_a_strong_password
# Optional signing secret for session cookies (defaults to derived from ADMIN_PASSWORD)
SESSION_SECRET=change_me_to_a_random_32_char_secret

# --- Shared PostgreSQL Database (SAME Neon/Supabase DATABASE_URL as Heroku!) ---
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- GitHub Image Storage (uploads images straight to your repo's assets/images/) ---
GITHUB_REPO=your-username/barca-x-bot
GITHUB_BRANCH=main
GITHUB_TOKEN=github_pat_your_fine_grained_token_with_contents_read_write

# --- Optional: Gemini Keys for 1-Click Live Preview Inside the Admin Dashboard ---
BARCA_GEMINI_API_KEY=
BARCA_GEMINI_API_KEY_2=

# --- Optional: X API Keys for 1-Click "Sync Views from X" Button in Club Analytics ---
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
